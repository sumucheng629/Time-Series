# More reliable data reading function
read_tennis_data <- function(year) {
tryCatch({
url <- paste0("https://raw.githubusercontent.com/JeffSackmann/tennis_atp/master/atp_matches_", year, ".csv")
data <- read_csv(url, show_col_types = FALSE, progress = FALSE)
data_clean <- data %>%
select(
tourney_date, match_num, tourney_name, surface,
winner_id, winner_name,
loser_id, loser_name
) %>%
mutate(
tourney_date = ymd(tourney_date),
winner_id = as.character(winner_id),
loser_id = as.character(loser_id),
match_num = as.integer(match_num),
year = year
) %>%
arrange(tourney_date, match_num) %>%
filter(!is.na(tourney_date), !is.na(winner_name), !is.na(loser_name))
cat("Successfully read data for", year, ":", nrow(data_clean), "matches\n")
return(data_clean)
}, error = function(e) {
cat("Error reading data for", year, ":", e$message, "\n")
return(NULL)
})
}
years <- 2016:2020
cat("Starting to read data for", length(years), "years...\n")
matches_data_list <- map(years, read_tennis_data)
matches_data <- matches_data_list %>%
compact() %>%
bind_rows()
# Display basic dataset information
cat("\nFinal dataset information:\n")
# Display basic dataset information
cat("\nFinal dataset information:\n")
cat("Total matches:", nrow(matches_data), "\n")
matches_data
View(matches_data)
