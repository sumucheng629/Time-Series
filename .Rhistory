library(readr)
# =========================
# 1. 数据读入与标准化 (结合老师课件第1、2页)
# =========================
setwd("C:\\Users\\33169\\Desktop\\singapore birth-fertility EDA")
birth_raw <- read_csv("BirthsAndFertilityRatesAnnual.csv")
births <- birth_raw |>
pivot_longer(cols = -DataSeries, names_to = "Year", values_to = "value") |>
mutate(Year = as.integer(Year), value = as.numeric(value)) |>
filter(Year >= 1960, Year <= 2024,
DataSeries %in% c("Total Fertility Rate (TFR)", "Total Live-Births")) |>
# 转换为 tsibble，Key 是 series (分类)，Index 是 Year (时间)
as_tsibble(key = DataSeries, index = Year)
# 快速检查 tsibble 结构 (对应课件第2、3页方法)
index_var(births)
births <- birth_raw |>
pivot_longer(cols = -DataSeries, names_to = "Year", values_to = "value") |>
mutate(Year = as.integer(Year), value = as.numeric(value)) |>
filter(Year >= 1960, Year <= 2024,
DataSeries %in% c("Total Fertility Rate (TFR)", "Total Live-Births")) |>
# 转换为 tsibble，Key 是 series (分类)，Index 是 Year (时间)
as_tsibble(key = DataSeries, index = Year)
births <- birth_raw |>
pivot_longer(
cols = -DataSeries,
names_to = "Year",
values_to = "value",
# 关键点：强制将所有年份下的数值转换为数值型，统一类型
values_transform = list(value = as.numeric)
) |>
mutate(
Year = as.integer(Year)
) |>
filter(Year >= 1960, Year <= 2024,
DataSeries %in% c("Total Fertility Rate (TFR)", "Total Live-Births")) |>
# 转换为 tsibble，Key 是 series (分类)，Index 是 Year (时间)
as_tsibble(key = DataSeries, index = Year)
# 快速检查 tsibble 结构 (对应课件第2、3页方法)
index_var(births)
key_vars(births)
# 老师课件中提到的查看频率
common_periods(births)
# =========================
# 2. 探索性可视化 (对应课件第5、6页)
# =========================
# 利用 autoplot 自动识别 Key，一次性画出两条曲线
births |> autoplot(value) + facet_wrap(~DataSeries, scales = "free_y")
# 查看 ACF 和 PACF (对应课件第6页)
births |> ACF(value) |> autoplot()
births |> PACF(value) |> autoplot()
# =========================
# 3. 趋势模型拟合 (完全参照老师 Mauna Loa 案例代码)
# =========================
# 在一个 model 函数里对两个序列同时拟合三种模型
fit_models <- births |>
model(
linear = TSLM(value ~ trend()),
quad   = TSLM(value ~ trend() + I(trend()^2)),
cubic  = TSLM(value ~ trend() + I(trend()^2) + I(trend()^3))
)
# 查看模型统计量 (AICc, CV 等，对应老师代码 glance 部分)
glance(fit_models) |> arrange(DataSeries, AICc)
# =========================
# 4. 残差诊断 (对应老师最后几页关于 .resid 的分析)
# =========================
# 提取拟合值和残差
fit_aug <- augment(fit_models)
# 绘制残差图：检查是否为白噪声
fit_aug |>
filter(.model == "cubic") |>
autoplot(.resid) +
labs(title = "Cubic Model Residuals")
# Portmanteau 检验 (对应老师代码：mauna |> features(..., portmanteau_tests))
# 检查残差是否还有未捕获的相关性
fit_aug |>
features(.resid, portmanteau_tests)
