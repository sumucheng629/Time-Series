#FiveThirtyEight update function
five38_update <- function(n_matches) {
delta <- 100
nu <- 5
sigma <- 0.1
return(delta / ((n_matches + nu)^sigma))
}
#Advanced Elo computation function
compute_elo_advanced <- function(matches, update_function, init_rating = 1500) {
player_ratings <- new.env(hash = TRUE)
player_match_counts <- new.env(hash = TRUE)
results <- matches
results$winner_elo_before <- NA_real_
results$loser_elo_before <- NA_real_
results$winner_elo_after <- NA_real_
results$loser_elo_after <- NA_real_
results$winner_prob <- NA_real_
results$winner_k <- NA_real_
results$loser_k <- NA_real_
total_matches <- nrow(results)
start_time <- Sys.time()
cat("Starting processing", total_matches, "matches...\n")
for (i in 1:total_matches) {
winner_id <- results$winner_id[i]
loser_id <- results$loser_id[i]
if (is.null(player_ratings[[winner_id]])) {
player_ratings[[winner_id]] <- init_rating
player_match_counts[[winner_id]] <- 0
}
if (is.null(player_ratings[[loser_id]])) {
player_ratings[[loser_id]] <- init_rating
player_match_counts[[loser_id]] <- 0
}
w_rating <- player_ratings[[winner_id]]
l_rating <- player_ratings[[loser_id]]
w_matches <- player_match_counts[[winner_id]]
l_matches <- player_match_counts[[loser_id]]
w_k <- update_function(w_matches)
l_k <- update_function(l_matches)
expected_win <- 1 / (1 + 10^((l_rating - w_rating) / 400))
w_new_rating <- w_rating + w_k * (1 - expected_win)
l_new_rating <- l_rating + l_k * (0 - (1 - expected_win))
results$winner_elo_before[i] <- w_rating
results$loser_elo_before[i] <- l_rating
results$winner_elo_after[i] <- w_new_rating
results$loser_elo_after[i] <- l_new_rating
results$winner_prob[i] <- expected_win
results$winner_k[i] <- w_k
results$loser_k[i] <- l_k
player_ratings[[winner_id]] <- w_new_rating
player_ratings[[loser_id]] <- l_new_rating
player_match_counts[[winner_id]] <- w_matches + 1
player_match_counts[[loser_id]] <- l_matches + 1
if (i %% 1000 == 0) {
elapsed <- as.numeric(difftime(Sys.time(), start_time, units = "secs"))
matches_per_sec <- i / elapsed
remaining <- (total_matches - i) / matches_per_sec
cat(sprintf("Processed %d/%d matches (%.1f%%) [%.1f matches/sec, estimated remaining: %.0f sec]\n",
i, total_matches, i/total_matches*100, matches_per_sec, remaining))
}
}
end_time <- Sys.time()
cat(sprintf("Processing completed! Total time: %.1f minutes\n",
as.numeric(difftime(end_time, start_time, units = "mins"))))
return(results)
}
#Compute Elo ratings
cat("Starting Elo rating calculation...\n")
elo_results <- compute_elo_advanced(matches_data, five38_update)
cat("Elo rating calculation completed\n")
# Filter and process Rafael Nadal's match data
nadal_matches <- elo_results %>%
filter(winner_name == "Rafael Nadal" | loser_name == "Rafael Nadal") %>%
mutate(
# Calculate Nadal's Elo ratings before and after each match
nadal_elo_after = ifelse(winner_name == "Rafael Nadal", winner_elo_after, loser_elo_after),
nadal_elo_before = ifelse(winner_name == "Rafael Nadal", winner_elo_before, loser_elo_before),
# Identify opponent and match result
opponent = ifelse(winner_name == "Rafael Nadal", loser_name, winner_name),
result = ifelse(winner_name == "Rafael Nadal", "Win", "Loss"),
# Create match index and extract year
match_index = row_number(),
year = year(tourney_date)
) %>%
# Select relevant columns
select(tourney_date, year, match_num, tourney_name, surface, opponent, result,
winner_prob, nadal_elo_before, nadal_elo_after, match_index)
# Print summary statistics
cat("Found Rafael Nadal matches:", nrow(nadal_matches), "\n")
cat("Year range:", min(nadal_matches$year), "-", max(nadal_matches$year), "\n")
matches_data <- matches_data_list %>%
compact() %>%
bind_rows()
matches_data
# Display basic dataset information
cat("\nFinal dataset information:\n")
cat("Total matches:", nrow(matches_data), "\n")
cat("Year range:", min(matches_data$year), "-", max(matches_data$year), "\n")
cat("Number of players:", length(unique(c(matches_data$winner_name, matches_data$loser_name))), "\n")
cat("Unique tournaments:", length(unique(matches_data$tourney_name)), "\n")
# Check if Rafael Nadal is in the dataset
nadal_in_data <- any(matches_data$winner_name == "Rafael Nadal" | matches_data$loser_name == "Rafael Nadal")
cat("Rafael Nadal in dataset:", nadal_in_data, "\n")
